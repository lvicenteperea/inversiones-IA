APP_NAME=Inversiones IA
APP_ENV=local
DEBUG=true

# MariaDB local
# Ajusta usuario, password y puerto segun tu entorno.
# Ejemplo probado en el entorno local de Luis: puerto 13306.
DATABASE_URL=mysql+pymysql://inv_user:inv_password@127.0.0.1:13306/inversiones_ia

# Alternativas:
# MariaDB local estandar: mysql+pymysql://inv_user:inv_password@127.0.0.1:3306/inversiones_ia
# MariaDB Docker del proyecto: mysql+pymysql://inv_user:inv_password@127.0.0.1:3307/inversiones_ia

# CORS
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Security placeholder for future login/JWT
SECRET_KEY=change-me-in-production
